PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-value

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cybar_app
DB_PASSWORD=
DB_NAME=cybar
DB_POOL_SIZE=10

# 阿里云百炼（北京地域）。业务空间可覆盖为专属域名。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
AI_TEXT_MODEL=qwen3.7-flash
AI_IMAGE_MODEL=z-image-turbo
AI_REQUEST_TIMEOUT_MS=20000
AI_IMAGE_TIMEOUT_MS=45000
AI_MEMORY_CACHE_MAX=200
AI_MEMORY_CACHE_TTL_MS=600000
AI_DB_CACHE_TTL_DAYS=30
AI_STALE_CACHE_DAYS=90
AI_ANALYSIS_RATE_LIMIT=60
AI_ANALYSIS_RATE_WINDOW_MS=600000
AI_GENERATE_RATE_LIMIT=10
AI_GENERATE_RATE_WINDOW_MS=3600000
AI_IMAGE_RATE_LIMIT=10
AI_IMAGE_RATE_WINDOW_MS=3600000
AI_TEMP_IMAGE_TTL_MS=86400000
AI_MAX_IMAGE_BYTES=8388608
